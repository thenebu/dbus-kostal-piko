# dbus-kostal-piko: take this RS485 adapter out of serial-starter rotation.
#
# Without this rule, Victron's serial-starter cycles its built-in driver
# probes (cgwacs, fzsonick, imt, modbus-client, gps, vedirect) on every
# USB-RS485 port it discovers. Each probe opens the port for ~30 seconds
# and clobbers our exclusive Modbus session, causing transient read errors
# of the form "device disconnected or multiple access on port".
#
# Setting VE_SERVICE="ignore" tells serial-starter to skip this device.
#
# The filename starts with "zz" so this rule is processed AFTER the stock
# /etc/udev/rules.d/serial-starter.rules, overriding the VE_SERVICE value
# it would otherwise assign (rs485:default).
#
# This file is generated by install.sh from the template:
#   udev/zz-dbus-kostal-piko.rules.template
# and copied to /etc/udev/rules.d/ during install. Because /etc/ is wiped
# on a VenusOS firmware update, install.sh also writes a /data/rcS.local
# hook that re-deploys this rule on every boot.

ACTION=="add", ENV{ID_BUS}=="usb", ENV{ID_VENDOR_ID}=="@VENDOR_ID@", ENV{ID_MODEL_ID}=="@MODEL_ID@", ENV{ID_SERIAL_SHORT}=="@SERIAL_SHORT@", ENV{VE_SERVICE}="ignore"
